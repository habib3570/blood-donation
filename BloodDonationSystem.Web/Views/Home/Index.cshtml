@using BloodDonationSystem.Application.DTOs.Statistics
@{
    ViewData["Title"] = "Home";
    var stats = ViewBag.Stats as DashboardStatsDto;
    var emergencies = ViewBag.Emergencies as List<BloodDonationSystem.Application.DTOs.Emergency.EmergencyRequestDto> ?? new();
    var topDonors = ViewBag.TopDonors as List<BloodDonationSystem.Application.DTOs.Donor.DonorDto> ?? new();
}

<!-- HERO -->
<!-- HERO SECTION (Clean, Minimalist, Centered High-Impact Search) -->
<section class="hero-section text-center" style="background: #FFFFFF !important; color: #0F172A !important; padding: 4rem 0 3.5rem; border-bottom: 1px solid #E2E8F0; position: relative;">
    <div class="container">
        
        <!-- Trust Pill Tag -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.78rem; font-weight: 600; color: #475569;">
            <span style="width: 8px; height: 8px; border-radius: 50%; background: #16A34A; display: inline-block;"></span>
            Verified Voluntary Blood Donation Network · Bangladesh
        </div>

        <!-- Main Headline -->
        <h1 class="hero-title mb-3" style="font-size: 2.9rem; font-weight: 800; color: #0F172A !important; letter-spacing: -0.03em; line-height: 1.15;">
            Donate Blood, <span style="color: #DC2626 !important;">Save Lives.</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle mx-auto mb-4" style="font-size: 1.05rem; color: #475569 !important; max-width: 680px; line-height: 1.6;">
            Connect directly with verified voluntary blood donors near your hospital in real-time. Free, non-commercial, and built for emergency response across 64 districts.
        </p>

        <!-- PROMINENT QUICK SEARCH BOX (3 Dropdowns + Find Donors) -->
        <div class="hero-search-card text-start mx-auto shadow-sm" style="background: #FFFFFF !important; border: 1px solid #CBD5E1; border-radius: 16px; padding: 1.35rem 1.5rem; max-width: 960px; box-shadow: 0 4px 24px -4px rgba(15, 23, 42, 0.08) !important;">
            <form asp-controller="Donor" asp-action="Search" method="get" id="homeSearchForm">
                <div class="row g-2 align-items-end">
                    
                    <!-- 1. Blood Group Dropdown -->
                    <div class="col-12 col-md-3">
                        <label class="form-label mb-1 text-start d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #475569;">
                            <i class="fas fa-droplet text-danger me-1"></i> Blood Group
                        </label>
                        <select name="BloodGroup" id="homeBloodGroupSelect" class="form-select" style="height: 46px; font-size: 0.875rem; font-weight: 600; color: #0F172A; border-color: #CBD5E1; background-color: #F8FAFC;">
                            <option value="">Any Blood Group</option>
                            <option value="0">A+ (A Positive)</option>
                            <option value="1">A- (A Negative)</option>
                            <option value="2">B+ (B Positive)</option>
                            <option value="3">B- (B Negative)</option>
                            <option value="4">AB+ (AB Positive)</option>
                            <option value="5">AB- (AB Negative)</option>
                            <option value="6" selected>O+ (O Positive)</option>
                            <option value="7">O- (O Negative)</option>
                        </select>
                    </div>

                    <!-- 2. District Dropdown -->
                    <div class="col-12 col-md-3">
                        <label class="form-label mb-1 text-start d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #475569;">
                            <i class="fas fa-location-dot text-danger me-1"></i> District
                        </label>
                        <select name="District" id="homeDistrictSelect" class="form-select" style="height: 46px; font-size: 0.875rem; color: #0F172A; border-color: #CBD5E1; background-color: #F8FAFC;">
                            <option value="">All Districts</option>
                        </select>
                    </div>

                    <!-- 3. Upazila / Thana Cascading Dropdown -->
                    <div class="col-12 col-md-3">
                        <label class="form-label mb-1 text-start d-block" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #475569;">
                            <i class="fas fa-city text-danger me-1"></i> Upazila / Thana
                        </label>
                        <select name="Upazila" id="homeUpazilaSelect" class="form-select" style="height: 46px; font-size: 0.875rem; color: #0F172A; border-color: #CBD5E1; background-color: #F8FAFC;">
                            <option value="">All Upazilas / Thanas</option>
                        </select>
                    </div>

                    <!-- 4. Find Donors Button -->
                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn w-100 fw-bold d-flex align-items-center justify-content-center gap-2" style="height: 46px; background: #DC2626; color: #FFFFFF; border: none; border-radius: 8px; font-size: 0.92rem; box-shadow: 0 2px 6px rgba(220, 38, 38, 0.25);">
                            <i class="fas fa-search"></i> Find Donors
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <!-- Action CTAs & Helpline Callout -->
        <div class="d-flex align-items-center justify-content-center gap-3 mt-4 flex-wrap">
            <a asp-controller="Emergency" asp-action="Create" class="btn fw-semibold px-3 py-2 d-inline-flex align-items-center gap-2" style="font-size: 0.85rem; border-radius: 8px; background: #FEF2F2; color: #DC2626; border: 1px solid #FECACA;">
                <i class="fas fa-triangle-exclamation"></i> Emergency Blood Request
            </a>
            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn fw-semibold px-3 py-2 d-inline-flex align-items-center gap-2" style="font-size: 0.85rem; border-radius: 8px; background: #FFFFFF; color: #334155; border: 1px solid #CBD5E1;">
                    <i class="fas fa-hand-holding-heart text-danger"></i> Become a Donor
                </a>
            }
            <a asp-controller="Hospital" asp-action="Index" class="btn fw-semibold px-3 py-2 d-inline-flex align-items-center gap-2" style="font-size: 0.85rem; border-radius: 8px; background: #FFFFFF; color: #334155; border: 1px solid #CBD5E1;">
                <i class="fas fa-hospital text-muted"></i> Hospitals
            </a>
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded" style="background: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.82rem; color: #475569;">
                <i class="fas fa-phone-volume text-danger"></i> 24/7 Hotline: <strong class="ms-1" style="font-size: 0.95rem; color: #0F172A;">16600</strong>
            </div>
        </div>

    </div>
</section>

<!-- STATS -->
<section class="stats-section pb-3">
    <div class="container">
        <div class="row g-3 flex-nowrap overflow-auto">
            <div class="col-6 col-sm-3" style="min-width:140px;">
                <div class="stat-card">
                    <div class="stat-icon si-red"><i class="fas fa-users"></i></div>
                    <div class="stat-number">@(stats?.TotalDonors.ToString("N0") ?? "0")</div>
                    <div class="stat-label">Total Donors</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i> +@(stats?.NewDonorsThisMonth ?? 0) this month</div>
                </div>
            </div>
            <div class="col-6 col-sm-3" style="min-width:140px;">
                <div class="stat-card">
                    <div class="stat-icon si-blue"><i class="fas fa-tint"></i></div>
                    <div class="stat-number">@(stats?.TotalDonations.ToString("N0") ?? "0")</div>
                    <div class="stat-label">Total Donations</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i> +@(stats?.NewDonationsThisWeek ?? 0) this week</div>
                </div>
            </div>
            <div class="col-6 col-sm-3" style="min-width:140px;">
                <div class="stat-card">
                    <div class="stat-icon si-green"><i class="fas fa-heart"></i></div>
                    <div class="stat-number">@(stats?.LivesSaved.ToString("N0") ?? "0")</div>
                    <div class="stat-label">Lives Saved</div>
                    <div class="stat-change"><i class="fas fa-arrow-up"></i> Est. 3x donations</div>
                </div>
            </div>
            <div class="col-6 col-sm-3" style="min-width:140px;">
                <div class="stat-card">
                    <div class="stat-icon si-orange"><i class="fas fa-exclamation-circle"></i></div>
                    <div class="stat-number">@(stats?.EmergencyRequests ?? 0)</div>
                    <div class="stat-label">Emergency Requests</div>
                    <div class="stat-change" style="color:var(--deep-red);">
                        <i class="fas fa-circle"></i> @(emergencies.Count) Active now
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CONTENT -->
<section class="section-pad">
    <div class="container">
        <div class="row g-4">

            <!-- LEFT -->
            <div class="col-lg-8">

                <!-- AVAILABLE DONORS -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div class="section-title">Available Donors</div>
                        <div class="section-subtitle">Sorted by Smart Priority Score</div>
                    </div>
                    <a asp-controller="Donor" asp-action="Search" class="view-all-link">
                        View All <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                @if (topDonors.Any())
                {
                    <div class="row g-3">
                        @foreach (var donor in topDonors.Take(4))
                        {
                            <div class="col-md-6">
                                <div class="donor-card">
                                    <div class="donor-card-header">
                                        <div class="donor-avatar">@donor.FullName[0]</div>
                                        <div class="flex-grow-1">
                                            <div class="donor-name">
                                                @donor.FullName
                                                @if (donor.IsVerifiedDonor)
                                                {
                                                    <span class="badge-verified"><i class="fas fa-check-circle"></i> Verified</span>
                                                }
                                            </div>
                                            <div class="donor-loc">
                                                <i class="fas fa-map-marker-alt"></i>
                                                @donor.Upazila, @donor.District
                                                @if (donor.DistanceKm.HasValue)
                                                {
                                                    <span>· @donor.DistanceKm.Value.ToString("0.0") km</span>
                                                }
                                            </div>
                                            <div class="mt-1">
                                                @{
                                                    var levelClass = donor.Level.ToString() switch
                                                    {
                                                        "LifeSaver" => "lv-gold",
                                                        "Hero" => "lv-hero",
                                                        "Helper" => "lv-silver",
                                                        _ => "lv-new"
                                                    };
                                                    var levelIcon = donor.Level.ToString() switch
                                                    {
                                                        "LifeSaver" => "fa-award",
                                                        "Hero" => "fa-bolt",
                                                        "Helper" => "fa-shield-halved",
                                                        _ => "fa-circle-check"
                                                    };
                                                }
                                                <span class="level-badge @levelClass"><i class="fas @levelIcon me-1"></i> @donor.LevelDisplay</span>
                                            </div>
                                        </div>
                                        <span class="donor-blood-tag">@donor.BloodGroupDisplay</span>
                                    </div>
                                    <div class="donor-card-body">
                                        <div class="donor-pills">
                                            <div class="donor-pill"><i class="fas fa-tint"></i> @donor.TotalDonations Donations</div>
                                            <div class="donor-pill"><i class="fas fa-star"></i> @donor.AverageRating.ToString("0.0")</div>
                                            <div class="donor-pill"><i class="fas fa-heart"></i> @donor.LivesSaved Lives</div>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="avail-badge @(donor.IsAvailable ? "avail-yes" : "avail-no")">
                                                <span class="avail-dot"></span>
                                                @(donor.IsAvailable ? "Available Now" : "Unavailable")
                                            </span>
                                            @if (donor.LastSeenAt.HasValue)
                                            {
                                                <span class="last-seen">
                                                    Last seen @((DateTime.UtcNow - donor.LastSeenAt.Value).TotalMinutes < 60
                                                                                            ? $"{(int)(DateTime.UtcNow - donor.LastSeenAt.Value).TotalMinutes}m ago"
                                                                                            : $"{(int)(DateTime.UtcNow - donor.LastSeenAt.Value).TotalHours}h ago")
                                    </span>
                                                                        }
                                        </div>
                                    </div>
                                    <div class="donor-card-footer">
                                        @if (donor.IsAvailable)
                                        {
                                            <a href="tel:@donor.PhoneNumber" class="btn-sm-red flex-grow-1 justify-content-center">
                                                <i class="fas fa-phone"></i> Call
                                            </a>
                                            <a href="https://wa.me/@donor.PhoneNumber" target="_blank" class="btn-sm-outline">
                                                <i class="fab fa-whatsapp"></i>
                                            </a>
                                            <a asp-controller="Chat" asp-action="Index" asp-route-userId="@donor.UserId" class="btn-sm-outline">
                                                <i class="fas fa-comment"></i>
                                            </a>
                                        }
                                        <a asp-controller="Donor" asp-action="Profile" asp-route-id="@donor.DonorProfileId" class="btn-sm-outline">
                                            <i class="fas fa-user"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="info-card text-center py-4">
                        <div class="mb-3 text-muted"><i class="fas fa-droplet fa-2x text-danger opacity-50"></i></div>
                        <div style="font-weight:700;color:var(--navy-blue);margin-bottom:0.5rem;">No Donors Found</div>
                        <div style="font-size:0.85rem;color:var(--text-muted);">Be the first to register as a donor!</div>
                        <a asp-controller="Donor" asp-action="BecomeDonor" class="btn-red mt-3">
                            <i class="fas fa-tint"></i> Become a Donor
                        </a>
                    </div>
                }

                <!-- EMERGENCY REQUESTS -->
                @if (emergencies.Any())
                {
                    <div class="d-flex align-items-center justify-content-between mt-4 mb-3">
                        <div>
                            <div class="section-title">Emergency Requests</div>
                            <div class="section-subtitle">Respond immediately to save lives</div>
                        </div>
                        <a asp-controller="Emergency" asp-action="Index" class="view-all-link">
                            View All <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var emg in emergencies.Take(3))
                        {
                            <div class="emergency-req-card">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="emg-blood-box">@emg.BloodGroupDisplay</div>
                                    <div class="flex-grow-1">
                                        <div style="font-size:0.95rem;font-weight:700;color:var(--navy-blue);margin-bottom:0.25rem;">
                                            @emg.PatientName · @emg.HospitalName
                                        </div>
                                        <div style="font-size:0.8rem;color:var(--text-muted);">
                                            <i class="fas fa-map-marker-alt"></i> @emg.Upazila, @emg.District · @emg.UnitsNeeded units needed
                                        </div>
                                        <div style="font-size:0.8rem;color:var(--text-muted);margin-top:0.2rem;">
                                            <i class="fas fa-phone"></i> @emg.ContactNumber
                                        </div>
                                    </div>
                                    <div class="emg-timer">
                                        <i class="fas fa-clock"></i>
                                        @{
                                            var remaining = emg.ExpiryDate - DateTime.UtcNow;
                                        }
                                        @(remaining.TotalHours > 1 ? $"{(int)remaining.TotalHours}h {remaining.Minutes}m" : $"{remaining.Minutes}m") left
                                    </div>
                                </div>
                                <div class="emg-footer">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form asp-controller="Emergency" asp-action="Accept" asp-route-id="@emg.Id" method="post" class="flex-grow-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-sm-red w-100 justify-content-center">
                                                <i class="fas fa-check"></i> Accept & Help
                                            </button>
                                        </form>
                                    }
                                    <a asp-controller="Emergency" asp-action="Details" asp-route-id="@emg.Id" class="btn-sm-outline">
                                        <i class="fas fa-info-circle"></i> Details
                                    </a>
                                    @if (!string.IsNullOrEmpty(emg.HospitalName))
                                    {
                                        <a href="https://maps.google.com/?q=@emg.HospitalLatitude,@emg.HospitalLongitude" target="_blank" class="btn-sm-outline">
                                            <i class="fas fa-map"></i> Map
                                        </a>
                                    }
                                    <a href="tel:@emg.ContactNumber" class="btn-sm-outline">
                                        <i class="fas fa-phone"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="col-lg-4">

                <!-- SOS EMERGENCY BOX -->
                <div class="sos-wrap mb-4">
                    <div class="d-flex align-items-center gap-2 mb-2 text-start">
                        <div class="brand-icon" style="width:36px;height:36px;flex-shrink:0;">
                            <i class="fas fa-truck-medical"></i>
                        </div>
                        <div>
                            <div class="sos-title text-start">Emergency SOS</div>
                            <div class="sos-desc text-start m-0">Need urgent blood within 1-2 hours?</div>
                        </div>
                    </div>
                    <a asp-controller="Emergency" asp-action="SOS" class="sos-circle text-decoration-none mt-2">
                        <i class="fas fa-triangle-exclamation"></i>
                        <span>Broadcast Emergency Alert</span>
                    </a>
                    <div class="bg-light-gray p-2 rounded border mt-2 text-center" style="font-size: 0.78rem;">
                        National 24/7 Helpline: <strong class="text-navy">16600</strong>
                    </div>
                </div>

                <!-- LEADERBOARD -->
                <div class="leaderboard-card mb-4">
                    <div class="lb-header">
                        <span><i class="fas fa-trophy"></i> Monthly Top Donors</span>
                        <a asp-controller="Leaderboard" asp-action="Index">View All</a>
                    </div>
                    <div>
                        @{
                            int lbRank = 1;
                        }
                        @foreach (var donor in topDonors.Take(5))
                        {
                            var rankClass = lbRank switch { 1 => "r1", 2 => "r2", 3 => "r3", _ => "rn" };
                            <div class="lb-item">
                                <div class="rank-num @rankClass">@lbRank</div>
                                <div class="lb-av">@donor.FullName[0]</div>
                                <div class="lb-name">
                                    @donor.FullName<br>
                                    <span style="font-size:0.7rem;color:var(--text-muted);">@donor.District · @donor.BloodGroupDisplay</span>
                                </div>
                                <div class="lb-pts">@donor.TotalPoints pts</div>
                            </div>
                            lbRank++;
                        }
                        @if (!topDonors.Any())
                        {
                            <div class="text-center py-3" style="color:var(--text-muted);font-size:0.85rem;">
                                No donors yet
                            </div>
                        }
                    </div>
                </div>

                <!-- BLOOD COMPATIBILITY -->
                <div class="info-card mb-4">
                    <div class="info-card-title"><i class="fas fa-exchange-alt"></i> Blood Compatibility</div>
                    <div class="compat-row">
                        <span class="blood-tag">O-</span>
                        <i class="fas fa-arrow-right" style="color:var(--text-muted);font-size:0.7rem;"></i>
                        <span style="font-size:0.75rem;color:var(--text-muted);">Donates to</span>
                        <span class="blood-tag-sm">All Types</span>
                    </div>
                    <div class="compat-row">
                        <span class="blood-tag">AB+</span>
                        <i class="fas fa-arrow-left" style="color:var(--text-muted);font-size:0.7rem;"></i>
                        <span style="font-size:0.75rem;color:var(--text-muted);">Receives from</span>
                        <span class="blood-tag-sm">All Types</span>
                    </div>
                    <div class="compat-row">
                        <span class="blood-tag">A+</span>
                        <i class="fas fa-arrow-right" style="color:var(--text-muted);font-size:0.7rem;"></i>
                        <span class="blood-tag-sm">A+</span>
                        <span class="blood-tag-sm">AB+</span>
                    </div>
                    <div class="compat-row">
                        <span class="blood-tag">B+</span>
                        <i class="fas fa-arrow-right" style="color:var(--text-muted);font-size:0.7rem;"></i>
                        <span class="blood-tag-sm">B+</span>
                        <span class="blood-tag-sm">AB+</span>
                    </div>
                    <a asp-controller="Home" asp-action="About" class="view-all-link mt-2 d-inline-flex">
                        Full Chart <i class="fas fa-arrow-right"></i>
                    </a>
                </div>

                <!-- MOST NEEDED -->
                <!-- MOST NEEDED -->
                <div class="info-card">
                    <div class="info-card-title"><i class="fas fa-fire"></i> Most Needed Right Now</div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (stats != null && stats.BloodGroupDistribution.Any())
                        {
                            @foreach (var n in stats.BloodGroupDistribution)
                            {
                                <div style="background:@(n.Hot ? "var(--deep-red-light)" : "var(--light-gray)");border:1.5px solid @(n.Hot ? "var(--deep-red)" : "var(--card-border)");border-radius:10px;padding:0.6rem 1rem;text-align:center;flex:1;min-width:60px;">
                                    <div style="font-size:1.05rem;font-weight:800;color:@(n.Hot ? "var(--deep-red)" : "var(--navy-blue)");">@n.Group</div>
                                    <div style="font-size:0.68rem;color:var(--text-muted);">@n.Count requests</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-2" style="color:var(--text-muted);font-size:0.85rem;">
                                No pending requests right now
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const districtSelect = document.getElementById('homeDistrictSelect');
            const upazilaSelect = document.getElementById('homeUpazilaSelect');

            if (districtSelect && upazilaSelect) {
                // 1. Fetch All Districts from backend
                try {
                    const res = await fetch('/Location/GetDistricts');
                    if (res.ok) {
                        const districts = await res.json();
                        let optionsHtml = '<option value="">All Districts</option>';
                        districts.forEach(d => {
                            optionsHtml += `<option value="${d.name}" data-id="${d.id}">${d.name}</option>`;
                        });
                        districtSelect.innerHTML = optionsHtml;
                    }
                } catch (err) {
                    console.error('Failed to load districts:', err);
                }

                // 2. Cascading Upazilas / Thanas on District Change
                districtSelect.addEventListener('change', async function () {
                    const selectedOpt = this.options[this.selectedIndex];
                    const districtId = selectedOpt ? selectedOpt.getAttribute('data-id') : null;

                    if (!districtId) {
                        upazilaSelect.innerHTML = '<option value="">All Upazilas / Thanas</option>';
                        return;
                    }

                    upazilaSelect.innerHTML = '<option value="">Loading Thanas...</option>';

                    try {
                        const res = await fetch(`/Location/GetUpazilas?districtId=${districtId}`);
                        if (res.ok) {
                            const upazilas = await res.json();
                            let upHtml = '<option value="">All Upazilas / Thanas</option>';
                            upazilas.forEach(u => {
                                upHtml += `<option value="${u.name}">${u.name}</option>`;
                            });
                            upazilaSelect.innerHTML = upHtml;
                        } else {
                            upazilaSelect.innerHTML = '<option value="">All Upazilas / Thanas</option>';
                        }
                    } catch (err) {
                        console.error('Failed to load upazilas:', err);
                        upazilaSelect.innerHTML = '<option value="">All Upazilas / Thanas</option>';
                    }
                });
            }
        });
    </script>
}