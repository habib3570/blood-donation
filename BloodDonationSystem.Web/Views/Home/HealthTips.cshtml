@{
    ViewData["Title"] = "Health Tips & Guidelines";
}

<div class="page-header">
    <div class="container">
        <div class="page-header-title">Health Tips & Donation Guidelines</div>
        <div class="page-header-sub">Medical guidelines for a safe, healthy blood donation experience</div>
        <div class="breadcrumb-custom">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span class="breadcrumb-sep">/</span>
            <span>Health Tips</span>
        </div>
    </div>
</div>

<section class="section-pad">
    <div class="container">
        <div class="row g-4">

            <!-- BEFORE DONATION -->
            <div class="col-md-4">
                <div class="form-card h-100">
                    <div class="brand-icon mx-auto mb-3" style="width:48px;height:48px;font-size:1.2rem;background:var(--deep-red-light);color:var(--deep-red);border:1px solid var(--deep-red-border);">
                        <i class="fas fa-apple-whole"></i>
                    </div>
                    <div style="font-size:1.05rem;font-weight:700;color:var(--navy-blue);text-align:center;margin-bottom:1rem;">
                        Before Donation
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var tip in new[]
                        {
                            "Drink at least 500ml (16 oz) of water before donating",
                            "Eat a wholesome, iron-rich meal 2-3 hours prior",
                            "Avoid fatty foods right before donating blood",
                            "Ensure at least 7-8 hours of restful sleep",
                            "Wear comfortable clothing with easily rollable sleeves",
                            "Bring a valid national ID and donor card"
                        })
                        {
                            <div class="d-flex align-items-start gap-2.5 p-2 rounded border" style="background:var(--light-gray);border-color:var(--card-border) !important;">
                                <i class="fas fa-circle-check text-red" style="margin-top:2px;flex-shrink:0;font-size:0.85rem;"></i>
                                <span style="font-size:0.82rem;color:var(--slate-700);">
                                    @tip
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- AFTER DONATION -->
            <div class="col-md-4">
                <div class="form-card h-100">
                    <div class="brand-icon mx-auto mb-3" style="width:48px;height:48px;font-size:1.2rem;background:#EFF6FF;color:#2563EB;border:1px solid #DBEAFE;">
                        <i class="fas fa-droplet"></i>
                    </div>
                    <div style="font-size:1.05rem;font-weight:700;color:var(--navy-blue);text-align:center;margin-bottom:1rem;">
                        After Donation
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var tip in new[]
                        {
                            "Rest quietly for 10-15 minutes immediately after",
                            "Drink plenty of fluids over the next 24-48 hours",
                            "Avoid alcohol consumption for at least 24 hours",
                            "Do not smoke for at least 1-2 hours post-donation",
                            "Keep the bandage dry and secure for at least 4 hours",
                            "Avoid strenuous gym workouts or lifting for 24 hours"
                        })
                        {
                            <div class="d-flex align-items-start gap-2.5 p-2 rounded border" style="background:var(--light-gray);border-color:var(--card-border) !important;">
                                <i class="fas fa-circle-info" style="color:#2563EB;margin-top:2px;flex-shrink:0;font-size:0.85rem;"></i>
                                <span style="font-size:0.82rem;color:var(--slate-700);">
                                    @tip
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ELIGIBILITY -->
            <div class="col-md-4">
                <div class="form-card h-100">
                    <div class="brand-icon mx-auto mb-3" style="width:48px;height:48px;font-size:1.2rem;background:var(--success-light);color:var(--success-green);border:1px solid #A7F3D0;">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                    <div style="font-size:1.05rem;font-weight:700;color:var(--navy-blue);text-align:center;margin-bottom:1rem;">
                        Who Can Donate
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @{
                            var criteria = new[]
                            {
                                new { Icon = "circle-check", Text = "Age between 18-60 years", Ok = true },
                                new { Icon = "circle-check", Text = "Minimum body weight: 50 kg", Ok = true },
                                new { Icon = "circle-check", Text = "Hemoglobin level ≥ 12.5 g/dL", Ok = true },
                                new { Icon = "circle-check", Text = "Normal blood pressure & pulse", Ok = true },
                                new { Icon = "circle-xmark", Text = "Pregnant or actively breastfeeding", Ok = false },
                                new { Icon = "circle-xmark", Text = "Recent major surgery or fever", Ok = false }
                            };
                        }
                        @foreach (var c in criteria)
                        {
                            <div class="d-flex align-items-start gap-2.5 p-2 rounded border"
                                 style="background:@(c.Ok ? "var(--success-light)" : "var(--deep-red-light)");border-color:@(c.Ok ? "#A7F3D0" : "var(--deep-red-border)") !important;">
                                <i class="fas fa-@c.Icon"
                                   style="color:@(c.Ok ? "var(--success-green)" : "var(--deep-red)");margin-top:2px;flex-shrink:0;font-size:0.85rem;"></i>
                                <span style="font-size:0.82rem;color:var(--slate-700);font-weight:@(c.Ok ? "500" : "600");">
                                    @c.Text
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- FACTS (Clean Clinical Fact Cards) -->
            <div class="col-12">
                <div class="info-card">
                    <div class="info-card-title">
                        <i class="fas fa-circle-question text-red"></i> Key Facts About Blood Donation
                    </div>
                    <div class="row g-3 mt-1">
                        @{
                            var facts = new[]
                            {
                                new { Icon = "fa-heart-pulse", Color = "var(--deep-red)", Fact = "One whole blood donation can save up to 3 separate patient lives." },
                                new { Icon = "fa-droplet", Color = "var(--deep-red)", Fact = "Blood cannot be synthetically manufactured — donors are the only source." },
                                new { Icon = "fa-clock", Color = "#2563EB", Fact = "The blood drawing process itself takes only 8 to 10 minutes." },
                                new { Icon = "fa-rotate", Color = "#059669", Fact = "Your body completely replenishes donated blood plasma within 24-48 hours." },
                                new { Icon = "fa-calendar-days", Color = "#7C3AED", Fact = "Healthy male donors can donate whole blood every 90 days safely." },
                                new { Icon = "fa-earth-americas", Color = "#0284C7", Fact = "Every 2 seconds, a patient in Bangladesh urgently needs a transfusion." }
                            };
                        }
                        @foreach (var fact in facts)
                        {
                            <div class="col-md-4">
                                <div class="p-3 rounded border h-100 d-flex align-items-center gap-3" style="background:var(--light-gray);border-color:var(--card-border) !important;">
                                    <div class="brand-icon" style="width:36px;height:36px;font-size:0.95rem;background:white;color:@fact.Color;border:1px solid var(--card-border);flex-shrink:0;">
                                        <i class="fas @fact.Icon"></i>
                                    </div>
                                    <div style="font-size:0.82rem;color:var(--slate-700);line-height:1.4;">
                                        @fact.Fact
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>