@using BloodDonationSystem.Application.DTOs.BloodRequest
@model List<BloodRequestDto>
@{
    ViewData["Title"] = "Manage Requests";
    Layout = "~/Views/Shared/_Layout.Admin.cshtml";
}

<div class="admin-page-header">
    <div class="admin-page-title"><i class="fas fa-droplet text-danger me-2"></i>Manage Blood Requests</div>
    <div class="admin-page-sub">Monitor all active blood requests</div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <span>All Requests</span>
        <span style="font-size:0.75rem;color:var(--text-muted);">
            @(Model?.Count ?? 0) records
        </span>
    </div>
    <div class="admin-card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th style="min-width: 180px;">Patient</th>
                        <th style="min-width: 110px;">Blood</th>
                        <th style="min-width: 200px;">Hospital</th>
                        <th style="min-width: 160px;">Requester</th>
                        <th style="min-width: 130px;">Status</th>
                        <th style="min-width: 120px;">Date</th>
                        <th style="min-width: 100px; text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var req in Model)
                        {
                            <tr>
                                <td style="font-weight: 600; color: #0F172A;">@req.PatientName</td>
                                <td>
                                    <span class="donor-blood-tag"
                                          style="position:static;font-size:0.78rem;">
                                        @req.BloodGroupDisplay
                                    </span>
                                </td>
                                <td style="font-size:0.84rem; color: #475569;">@req.HospitalName</td>
                                <td style="font-size:0.84rem; color: #475569;">@req.RequesterName</td>
                                <td>
                                    @{
                                        var sc = req.Status.ToString() switch
                                        {
                                            "Pending" => "sp-pending",
                                            "Accepted" => "sp-accepted",
                                            "Completed" => "sp-completed",
                                            "Rejected" => "sp-rejected",
                                            _ => "sp-expired"
                                        };
                                    }
                                    <span class="status-pill @sc">@req.StatusDisplay</span>
                                </td>
                                <td style="font-size:0.82rem;color:var(--text-muted);white-space:nowrap;">
                                    @req.CreatedAt.ToString("dd MMM yy")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@req.Id"
                                       class="btn-sm-outline" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4" style="color:var(--text-muted);">
                                No requests found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
