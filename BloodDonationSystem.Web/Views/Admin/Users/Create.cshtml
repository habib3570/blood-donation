@using BloodDonationSystem.Application.DTOs.User
@model CreateUserDto
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_Layout.Admin.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div class="admin-page-title">➕ Create New User</div>
            <div class="admin-page-sub">Admin can create a user account and assign a role directly</div>
        </div>
        <a asp-action="Index" class="btn-sm-outline">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-start gap-2" style="border-radius:12px;">
                <i class="fas fa-circle-exclamation mt-1"></i>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- SECTION: Account Info -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <span><i class="fas fa-user-circle"></i> Account Information</span>
                </div>
                <div class="admin-card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input asp-for="FullName" class="form-control-custom" placeholder="e.g. Habibur Rahman" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" type="email" class="form-control-custom" placeholder="example@mail.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control-custom" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" type="password" class="form-control-custom" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size:0.78rem;"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: Personal Details -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <span><i class="fas fa-id-card"></i> Personal Details</span>
                </div>
                <div class="admin-card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Blood Group</label>
                            <select asp-for="BloodGroup" asp-items="Html.GetEnumSelectList<BloodDonationSystem.Domain.Enums.BloodGroup>()" class="form-control-custom">
                                <option value="">-- Select Blood Group --</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Gender</label>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<BloodDonationSystem.Domain.Enums.Gender>()" class="form-control-custom">
                                <option value="">-- Select Gender --</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control-custom" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: Location -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <span><i class="fas fa-location-dot"></i> Location</span>
                </div>
                <div class="admin-card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">District</label>
                            <input asp-for="District" class="form-control-custom" placeholder="e.g. Dhaka" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Upazila</label>
                            <input asp-for="Upazila" class="form-control-custom" placeholder="e.g. Mirpur" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECTION: Role Assignment -->
            <div class="admin-card mb-4">
                <div class="admin-card-header">
                    <span><i class="fas fa-user-shield"></i> Role Assignment</span>
                </div>
                <div class="admin-card-body">
                    <label class="form-label fw-semibold mb-2">Select Role</label>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input type="radio" asp-for="Role" value="User" id="roleUser" class="role-radio-input" checked />
                            <label for="roleUser" class="role-radio-card">
                                <i class="fas fa-user"></i>
                                <div class="fw-semibold mt-2">User</div>
                                <div style="font-size:0.75rem;color:var(--text-muted);">Regular account</div>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" asp-for="Role" value="Donor" id="roleDonor" class="role-radio-input" />
                            <label for="roleDonor" class="role-radio-card">
                                <i class="fas fa-hand-holding-droplet"></i>
                                <div class="fw-semibold mt-2">Donor</div>
                                <div style="font-size:0.75rem;color:var(--text-muted);">Can donate blood</div>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" asp-for="Role" value="Admin" id="roleAdmin" class="role-radio-input" />
                            <label for="roleAdmin" class="role-radio-card">
                                <i class="fas fa-user-shield"></i>
                                <div class="fw-semibold mt-2">Admin</div>
                                <div style="font-size:0.75rem;color:var(--text-muted);">Full access</div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mb-5">
                <button type="submit" class="btn-primary-custom px-4">
                    <i class="fas fa-check"></i> Create User
                </button>
                <a asp-action="Index" class="btn-sm-outline px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .role-radio-input {
        display: none;
    }

    .role-radio-card {
        display: block;
        text-align: center;
        border: 2px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.25rem 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease;
        color: var(--navy-blue);
    }

        .role-radio-card i {
            font-size: 1.5rem;
            color: var(--text-muted);
        }

        .role-radio-card:hover {
            border-color: var(--deep-red);
        }

    .role-radio-input:checked + .role-radio-card {
        border-color: var(--deep-red);
        background: rgba(220, 38, 38, 0.05);
    }

        .role-radio-input:checked + .role-radio-card i {
            color: var(--deep-red);
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}