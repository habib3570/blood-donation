@using BloodDonationSystem.Application.DTOs.User
@model List<UserProfileDto>
@{
    ViewData["Title"] = "Manage Users"; Layout = "~/Views/Shared/_Layout.Admin.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div class="admin-page-title">👥 Manage Users</div>
            <div class="admin-page-sub">View, block, and verify all registered users</div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <input type="text" class="form-control-custom"
                   placeholder="🔍 Search users..."
                   id="userSearch"
                   onkeyup="filterTable()"
                   style="width:220px;" />
            <a asp-action="Create" class="btn-primary-custom">
                <i class="fas fa-plus"></i> Create User
            </a>
        </div>
    </div>
</div>
@Html.AntiForgeryToken()
<!-- QUICK STATS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon si-blue"><i class="fas fa-users"></i></div>
            <div class="stat-number">@(Model?.Count ?? 0)</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon si-green"><i class="fas fa-check-circle"></i></div>
            <div class="stat-number">@(Model?.Count(u => u.DonorInfo != null) ?? 0)</div>
            <div class="stat-label">Donors</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon si-orange"><i class="fas fa-shield-alt"></i></div>
            <div class="stat-number">@(Model?.Count(u => u.IsVerified) ?? 0)</div>
            <div class="stat-label">Verified</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon si-red"><i class="fas fa-ban"></i></div>
            <div class="stat-number">@(Model?.Count(u => u.IsBlocked) ?? 0)</div>
            <div class="stat-label">Blocked</div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <span>All Users</span>
        <span style="font-size:0.75rem;color:var(--text-muted);">
            @(Model?.Count ?? 0) records
        </span>
    </div>
    <div class="admin-card-body" style="padding:0;">
        <div class="table-responsive">
            <table class="table-custom" id="userTable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Blood Group</th>
                        <th>Location</th>
                        <th>Donor Status</th>
                        <th>Account</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-avatar-sm"
                                             style="width:34px;height:34px;font-size:0.85rem;flex-shrink:0;">
                                            @user.FullName[0]
                                        </div>
                                        <div>
                                            <div style="font-weight:600;font-size:0.85rem;">
                                                @user.FullName
                                            </div>
                                            <div style="font-size:0.75rem;color:var(--text-muted);">
                                                @user.Email
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="donor-blood-tag"
                                          style="position:static;font-size:0.78rem;">
                                        @user.BloodGroupDisplay
                                    </span>
                                </td>
                                <td style="font-size:0.82rem;">
                                    @user.Upazila, @user.District
                                </td>
                                <td>
                                    @if (user.DonorInfo != null)
                                    {
                                        <div>
                                            @if (user.DonorInfo.TotalDonations > 0)
                                            {
                                                <span class="status-pill sp-completed">
                                                    <i class="fas fa-tint"></i>
                                                    @user.DonorInfo.TotalDonations donations
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-pill sp-pending">Donor</span>
                                            }
                                        </div>
                                        <div class="mt-1">
                                            <span class="avail-badge @(user.DonorInfo.TotalDonations >= 0 ? "avail-yes" : "avail-no")"
                                                  style="font-size:0.68rem;">
                                                <span class="avail-dot"></span>
                                                @user.DonorInfo.Level
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="font-size:0.78rem;color:var(--text-muted);">
                                            Not a donor
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="status-pill sp-rejected">Blocked</span>
                                    }
                                    else if (user.IsVerified)
                                    {
                                        <span class="status-pill sp-completed">Verified</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill sp-pending">Active</span>
                                    }
                                </td>
                                <td style="font-size:0.78rem;color:var(--text-muted);">
                                    @user.CreatedAt.ToString("dd MMM yy")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@user.Id"
                                           class="btn-sm-outline" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (!user.IsBlocked)
                                        {
                                            <button onclick="blockUser('@user.Id')"
                                                    class="btn-sm-outline"
                                                    title="Block User"
                                                    style="color:#EF4444;border-color:#FECACA;">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button onclick="unblockUser('@user.Id')"
                                                    class="btn-sm-red"
                                                    title="Unblock User">
                                                <i class="fas fa-unlock"></i>
                                            </button>
                                        }
                                        @if (user.DonorInfo != null && !user.IsVerified)
                                        {
                                            <button onclick="verifyDonor(@user.DonorInfo.DonorProfileId)"
                                                    class="btn-sm-outline"
                                                    title="Verify Donor"
                                                    style="color:var(--success-green);border-color:#6EE7B7;">
                                                <i class="fas fa-check-circle"></i>
                                            </button>
                                        }
                                        <button onclick="openRoleModal('@user.Id')"
                                                class="btn-sm-outline"
                                                title="Change Role"
                                                style="color:var(--navy-blue);border-color:#BFDBFE;">
                                            <i class="fas fa-user-cog"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- ROLE CHANGE MODAL -->
<div id="roleModal" class="role-modal-overlay">
    <div class="role-modal-box">
        <div class="role-modal-header">
            <div class="role-modal-icon"><i class="fas fa-user-cog"></i></div>
            <div>
                <h5>Change User Role</h5>
                <p>Select a new role for this user</p>
            </div>
        </div>

        <input type="hidden" id="roleModalUserId" />

        <div class="role-modal-options">
            <label class="role-option">
                <input type="radio" name="roleModalRadio" value="User" checked />
                <div class="role-option-card">
                    <i class="fas fa-user"></i>
                    <span>User</span>
                </div>
            </label>
            <label class="role-option">
                <input type="radio" name="roleModalRadio" value="Donor" />
                <div class="role-option-card">
                    <i class="fas fa-hand-holding-droplet"></i>
                    <span>Donor</span>
                </div>
            </label>
            <label class="role-option">
                <input type="radio" name="roleModalRadio" value="Admin" />
                <div class="role-option-card">
                    <i class="fas fa-user-shield"></i>
                    <span>Admin</span>
                </div>
            </label>
        </div>

        <div class="role-modal-actions">
            <button onclick="closeRoleModal()" class="role-btn-cancel">Cancel</button>
            <button onclick="submitRoleChange()" class="role-btn-confirm">
                <i class="fas fa-check"></i> Update Role
            </button>
        </div>
    </div>
</div>
<style>
    .role-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        z-index: 1050;
        align-items: center;
        justify-content: center;
        animation: fadeIn 0.2s ease;
    }

    .role-modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 1.75rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        animation: slideUp 0.25s ease;
    }

    .role-modal-header {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.5rem;
    }

    .role-modal-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--deep-red), #b91c1c);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .role-modal-header h5 {
        font-weight: 700;
        margin: 0;
        color: var(--navy-blue);
        font-size: 1.05rem;
    }

    .role-modal-header p {
        margin: 0;
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .role-modal-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }

    .role-option input {
        display: none;
    }

    .role-option-card {
        border: 2px solid #E5E7EB;
        border-radius: 12px;
        padding: 0.9rem 0.4rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.18s ease;
        color: var(--text-muted);
    }

        .role-option-card i {
            font-size: 1.25rem;
            display: block;
            margin-bottom: 0.4rem;
        }

        .role-option-card span {
            font-size: 0.78rem;
            font-weight: 600;
        }

        .role-option-card:hover {
            border-color: #FCA5A5;
        }

    .role-option input:checked + .role-option-card {
        border-color: var(--deep-red);
        background: rgba(220, 38, 38, 0.06);
        color: var(--deep-red);
    }

    .role-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
    }

    .role-btn-cancel {
        padding: 0.55rem 1.1rem;
        border-radius: 8px;
        border: 1.5px solid #E5E7EB;
        background: #fff;
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .role-btn-cancel:hover {
            background: #F3F4F6;
        }

    .role-btn-confirm {
        padding: 0.55rem 1.3rem;
        border-radius: 8px;
        border: none;
        background: linear-gradient(135deg, var(--deep-red), #b91c1c);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.15s ease;
    }

        .role-btn-confirm:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    <script>
        function filterTable() {
            const query = document.getElementById('userSearch').value.toLowerCase();
            document.querySelectorAll('#userTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(query) ? '' : 'none';
            });
        }

        async function blockUser(userId) {
            if (!confirm('Block this user?')) return;
            try {
                const res = await fetch(`/AdminUser/Block/${userId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                if (!res.ok) { showToast(`Error: ${res.status} ${res.statusText}`, 'error'); return; }
                const data = await res.json();
                if (data.success) { showToast('User blocked.', 'success'); location.reload(); }
                else showToast(data.message, 'error');
            } catch (err) {
                showToast('Something went wrong: ' + err.message, 'error');
            }
        }

        async function unblockUser(userId) {
            if (!confirm('Unblock this user?')) return;
            try {
                const res = await fetch(`/AdminUser/Unblock/${userId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                if (!res.ok) { showToast(`Error: ${res.status} ${res.statusText}`, 'error'); return; }
                const data = await res.json();
                if (data.success) { showToast('User unblocked.', 'success'); location.reload(); }
                else showToast(data.message, 'error');
            } catch (err) {
                showToast('Something went wrong: ' + err.message, 'error');
            }
        }

        async function verifyDonor(donorProfileId) {
            if (!confirm('Verify this donor?')) return;
            try {
                const res = await fetch(`/AdminUser/VerifyDonor/${donorProfileId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': getAntiForgeryToken() }
                });
                if (!res.ok) { showToast(`Error: ${res.status} ${res.statusText}`, 'error'); return; }
                const data = await res.json();
                if (data.success) { showToast('Donor verified!', 'success'); location.reload(); }
                else showToast(data.message, 'error');
            } catch (err) {
                showToast('Something went wrong: ' + err.message, 'error');
            }
        }

        function openRoleModal(userId) {
            document.getElementById('roleModalUserId').value = userId;
            document.getElementById('roleModal').style.display = 'flex';
        }

        function closeRoleModal() {
            document.getElementById('roleModal').style.display = 'none';
        }

        async function submitRoleChange() {
            const userId = document.getElementById('roleModalUserId').value;
            const selectedRadio = document.querySelector('input[name="roleModalRadio"]:checked');
            if (!selectedRadio) {
                showToast('Please select a role.', 'error');
                return;
            }
            const newRole = selectedRadio.value;
            try {
                const res = await fetch(`/AdminUser/ChangeRole/${userId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': getAntiForgeryToken(),
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: `newRole=${encodeURIComponent(newRole)}`
                });
                closeRoleModal();
                if (!res.ok) { showToast(`Error: ${res.status} ${res.statusText}`, 'error'); return; }
                const data = await res.json();
                if (data.success) { showToast('Role updated!', 'success'); location.reload(); }
                else showToast(data.message, 'error');
            } catch (err) {
                closeRoleModal();
                showToast('Something went wrong: ' + err.message, 'error');
            }
        }
    </script>
}